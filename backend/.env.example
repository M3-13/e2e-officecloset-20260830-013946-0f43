# Kopieren Sie diese Datei nach `.env` und tragen Sie die Werte ein, bevor Sie
# das Backend starten. `.env` ist gitignored und wird von app/config.py gelesen.
#
# SECRET_KEY wird von RUN.json pro Lauf automatisch erzeugt (Hex, 32 Bytes).
# Erzeugen Sie sich selbst einen und tragen ihn hier ein:
#   py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///./wardrobe.db
UPLOAD_DIR=./uploads
FRONTEND_ORIGIN=http://localhost:5173
